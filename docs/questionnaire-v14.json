  "changelog": {
    "v14": [
      "HAPUS 18 pertanyaan lama (is_active=false):",
      "  - Kompetensi Teknis: os_familiarity, cli_proficiency, programming_logic_score, git_competency, problem_solving_independence, english_technical_proficiency, project_portfolio_count, data_literacy_score",
      "  - Ketersediaan Waktu: learning_session_span, preferred_time_slot, target_completion_duration, login_frequency_intent",
      "  - Gaya Belajar: learning_curve_steepness, social_dependency_level, assessment_type_preference",
      "  - Minat & Hardware: interest_frontend_ui, interest_data_math, interest_infrastructure, negative_constraint, hardware_constraint, bandwidth_constraint",
      "",
      "TAMBAH 3 pertanyaan Level (multi-signal):",
      "  - programming_familiarity (order 5) — Signal #1: aktivitas coding aktual",
      "  - domain_comfort (order 6) — Signal #2: comfort di domain spesifik",
      "  - formal_preparation (order 7) — Signal #3: validasi dari pendidikan/formal",
      "",
      "KEEP (tetap sama, is_active=true):",
      "  - Demografi: age_group, education_level, educational_background_relevance, employment_status (orders 1-4)",
      "  - Preference: weekly_availability_hours, learning_modality_preference, practicality_ratio (orders 8-10)",
      "  - Goal: target_role, primary_motivation, certification_importance (orders 11, 12, 14)",
      "  - Monetary: monetary_constraint (order 13)",
      "",
      "Level computation formula:",
      "  level_score = normalize(programming_familiarity * 0.35 + domain_comfort * 0.40 + formal_preparation * 0.25)",
      "  Beginner (0.00-0.35) | Lower Intermediate (0.35-0.55) | Intermediate (0.55-0.75) | Advanced (0.75-1.00)"
    ]
  }
